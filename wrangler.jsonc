
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quantbuild",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "QuantBuildContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUANTBUILD",
        "class_name": "QuantBuildContainer"
      }
    ]
  },
  "exports": {
    "QuantBuildContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
